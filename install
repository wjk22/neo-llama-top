#!/bin/sh
# Installs nltop and nltap, and sets nltap up as a systemd service.
#
#   ./install          asks a few questions, shows a summary, installs on "yes"
#   ./install --yes    takes the suggested answers without asking
#
# Every question comes with a suggested answer; Enter takes it. Nothing on the
# machine changes before the summary is confirmed. The answers are kept in
# install-answers.toml and suggested again next time.
#
# On a machine without Go: run ./build where Go is, copy the checkout with its
# builds/ folder over, and run ./install there.
#
# DESTDIR=/some/dir ./install writes everything below that folder and leaves
# users and services alone, for packaging and for trying the script out.
set -eu
cd "$(dirname "$0")"

answers=install-answers.toml
dest=${DESTDIR:-}
auto=no
case ${1:-} in
    --yes | -y) auto=yes ;;
    "") ;;
    *) echo "usage: ./install [--yes]" >&2; exit 2 ;;
esac

# ---------------------------------------------------------------- binaries

if command -v go >/dev/null 2>&1; then
    ./build
elif [ -x builds/nltop ] && [ -x builds/nltap ]; then
    echo "Go is not installed here; using the binaries in builds/: $(builds/nltop -version)"
else
    echo "install: Go is not installed here and builds/ has no binaries." >&2
    echo "         Run ./build on a machine with Go and copy builds/ over." >&2
    exit 1
fi

# ---------------------------------------------------------------- answers

saved() { # saved <key>: the answer of the last run, or nothing
    [ -f "$answers" ] && sed -n "s/^$1 = \"\\(.*\\)\"\$/\\1/p" "$answers" | tail -n 1
    return 0
}
or() { # or <value> <fallback>
    if [ -n "$1" ]; then printf '%s' "$1"; else printf '%s' "$2"; fi
}
ask() { # ask <question> <suggested answer>: prints the answer
    if [ "$auto" = yes ]; then
        printf '%s\n' "$2"
        return
    fi
    printf '%s [%s]: ' "$1" "$2" >&2
    reply=
    read -r reply || true
    or "$reply" "$2"
    echo
}

have_systemd=no
[ -d /run/systemd/system ] && have_systemd=yes

prefix=$(or "$(saved prefix)" "${PREFIX:-/usr/local}")
service=$(or "$(saved service)" "$have_systemd")
upstream=$(or "$(saved upstream)" "http://127.0.0.1:8080")
callers=$(or "$(saved callers)" "6081=Motoko 6082=Rico")

questions() {
    echo
    prefix=$(ask "Install nltop and nltap below" "$prefix")
    while :; do
        reply=$(ask "Run nltap as a systemd service, to see who calls llama-server? (yes/no)" "$service")
        case $reply in
            yes | y) service=yes ;;
            no | n) service=no ;;
            *) echo "  Please answer yes or no." >&2; continue ;;
        esac
        if [ "$service" = yes ] && [ "$have_systemd" = no ] && [ -z "$dest" ]; then
            echo "  This machine does not run systemd, so there is no service to set up." >&2
            service=no
        fi
        break
    done
    [ "$service" = yes ] || return 0

    upstream=$(ask "llama-server is at" "$upstream")
    echo "Each caller gets a port of its own on 127.0.0.1; nltap names callers by it." >&2
    old=$callers
    callers=
    i=1
    while :; do
        # The i-th caller of the last answers, as "port=name"; "-" ends the list.
        set -- $old
        suggested=-
        [ $# -ge $i ] && eval "suggested=\${$i}"
        port=$(ask "Caller $i: port (- for no more)" "${suggested%%=*}")
        case $port in
            - | "") break ;;
            *[!0-9]*) echo "  A port is a number, like 6081." >&2; continue ;;
        esac
        if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
            echo "  Ports go from 1 to 65535." >&2
            continue
        fi
        case " $callers" in *" $port="*) echo "  Port $port is taken by an earlier caller." >&2; continue ;; esac
        name=-
        [ "$suggested" != - ] && name=${suggested#*=}
        [ "$name" = - ] && name="Caller$i"
        name=$(ask "Caller $i: name" "$name")
        case $name in
            *[!A-Za-z0-9._-]* | "") echo "  Names are letters, digits, dots, dashes and underscores." >&2; continue ;;
        esac
        callers="$callers$port=$name "
        i=$((i + 1))
    done
    callers=${callers% }
    if [ -z "$callers" ]; then
        echo "  No caller, so no service." >&2
        service=no
    fi
}

summary() {
    bindir=$prefix/bin
    echo
    echo "Summary"
    echo "  binaries   $dest$bindir/nltop"
    echo "             $dest$bindir/nltap"
    if [ "$service" = yes ]; then
        echo "  service    nltap.service, as user nltap, started now and at every boot"
        echo "  forwards   to $upstream"
        label="callers   "
        for c in $callers; do
            echo "  $label 127.0.0.1:${c%%=*}  ${c#*=}"
            label="          "
        done
        echo "  config     $dest/etc/nltap.conf"
        echo "  log        /var/log/nltap/requests.jsonl"
    else
        echo "  service    none: nltop shows no callers"
    fi
    [ -z "$dest" ] || echo "  staged     below $dest: no user is created, no service is started"
    echo
}

while :; do
    questions
    summary
    [ "$auto" = yes ] && break
    printf 'Deploy? [yes / change / quit]: ' >&2
    reply=
    read -r reply || reply=quit
    case $reply in
        yes | y | Y | "") break ;;
        change | c) ;;
        *) echo "Nothing was changed."; exit 0 ;;
    esac
done

# ---------------------------------------------------------------- deploy

cat > "$answers" <<EOF
# Answers of the last ./install, suggested again next time. No secrets in here.
prefix = "$prefix"
service = "$service"
upstream = "$upstream"
callers = "$callers"
EOF

root() { # run a command as root, unless staging
    if [ -n "$dest" ] || [ "$(id -u)" = 0 ]; then
        "$@"
    else
        sudo "$@"
    fi
}
put() { # put <mode> <file> <target>: as the user where possible, as root where needed
    dir=$(dirname "$3")
    if mkdir -p "$dir" 2>/dev/null && [ -w "$dir" ]; then
        install -m "$1" "$2" "$3"
    else
        root install -D -m "$1" "$2" "$3"
    fi
}

put 0755 builds/nltop "$dest$bindir/nltop"
put 0755 builds/nltap "$dest$bindir/nltap"
echo "installed $dest$bindir/nltop and $dest$bindir/nltap"

if [ "$service" = yes ]; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT

    {
        echo "# nltap: names the callers of llama-server. Written by ./install."
        echo "# After a change: sudo systemctl restart nltap"
        echo
        echo "upstream = $upstream"
        echo "log      = /var/log/nltap/requests.jsonl"
        echo
        echo "# port = caller. A bare port listens on 127.0.0.1."
        for c in $callers; do
            echo "${c%%=*} = ${c#*=}"
        done
    } > "$tmp/nltap.conf"

    cat > "$tmp/nltap.service" <<EOF
[Unit]
Description=nltap: names the callers of llama-server
After=network.target

[Service]
User=nltap
Group=nltap
ExecStart=$bindir/nltap -config /etc/nltap.conf
LogsDirectory=nltap
LogsDirectoryMode=0755
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF

    conf=$dest/etc/nltap.conf
    if [ -f "$conf" ] && ! cmp -s "$tmp/nltap.conf" "$conf"; then
        root cp -p "$conf" "$conf.old"
        echo "the config that was there is kept as $conf.old"
    fi
    put 0644 "$tmp/nltap.conf" "$conf"
    put 0644 "$tmp/nltap.service" "$dest/etc/systemd/system/nltap.service"

    if [ -z "$dest" ]; then
        id nltap >/dev/null 2>&1 ||
            root useradd --system --user-group --no-create-home --shell /usr/sbin/nologin nltap
        root systemctl daemon-reload
        root systemctl enable --quiet nltap
        root systemctl restart nltap
        sleep 1
        if [ "$(systemctl is-active nltap)" = active ]; then
            echo "nltap is running:"
            for c in $callers; do
                echo "  http://127.0.0.1:${c%%=*}  for ${c#*=}"
            done
            echo "Point each caller at its port instead of $upstream."
        else
            echo "install: nltap did not start. See: journalctl -u nltap -n 20" >&2
            exit 1
        fi
    fi
fi
